NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taras_messenger?schema=public"

# JWT
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars_long"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars_long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS: перелічіть дозволені origin через кому
CLIENT_ORIGINS="http://localhost:5173,capacitor://localhost,http://localhost"

# Файли
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# Постійне сховище файлів (фото/відео/голосові в чаті) — Cloudinary,
# безкоштовно 25ГБ, без картки. Зареєструватись: https://cloudinary.com
# Дані знайдете на Dashboard одразу після реєстрації.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (вхід через код на пошту) — Gmail SMTP, безкоштовно
# 1. Увімкніть 2FA на своєму Gmail-акаунті
# 2. Створіть "App Password": https://myaccount.google.com/apppasswords
# 3. Вставте його сюди (НЕ звичайний пароль від Gmail!)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="ваша_пошта@gmail.com"
SMTP_PASS="app_password_16_символів"

# Web Push (згенерувати: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# HTTPS (для продакшн; у dev можна лишити пустим і йти через reverse proxy)
SSL_KEY_PATH=""
SSL_CERT_PATH=""
