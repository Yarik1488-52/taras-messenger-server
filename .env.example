NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taras_messenger?schema=public"

# JWT
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars_long"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars_long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS: перелічіть дозволені origin через кому
CLIENT_ORIGINS="http://localhost:5173,capacitor://localhost,http://localhost"

# Файли
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# Web Push (згенерувати: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# HTTPS (для продакшн; у dev можна лишити пустим і йти через reverse proxy)
SSL_KEY_PATH=""
SSL_CERT_PATH=""
